{
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "incremental": true,
        "strict": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules"]
}
